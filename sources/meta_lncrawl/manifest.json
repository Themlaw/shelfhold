{
  "key": "lncrawl",
  "kind": "source",
  "version": "0.1.0",
  "api": 1,
  "name": "lncrawl (connected service)",
  "permissions": {
    "domains": [
      {
        "pattern": "lncrawl.invalid",
        "purpose": "api",
        "base_url_setting": "base_url",
        "path_prefix": null
      }
    ],
    "lan_targets": [],
    "needs_browser": false,
    "needs_solver": false
  },
  "settings_schema": {
    "type": "object",
    "required": [
      "base_url"
    ],
    "properties": {
      "base_url": {
        "type": "string",
        "format": "uri",
        "title": "Address of your instance"
      },
      "api_key": {
        "type": "string",
        "format": "password",
        "writeOnly": true,
        "title": "API key of your account"
      }
    }
  },
  "content_warning": "mixed",
  "terms_url": "https://github.com/lncrawl/lightnovel-crawler/blob/dev/LICENSE",
  "respects_robots": false,
  "attribution": null,
  "homepage": "https://github.com/lncrawl/lightnovel-crawler",
  "langs": [],
  "content_kinds": [
    "file"
  ],
  "url_patterns": [],
  "capabilities": [
    "FOLLOW",
    "RANGED_CONTENT",
    "SEARCH"
  ],
  "rate_limit": {
    "requests_per_second": 5.0,
    "concurrency": 1
  },
  "auth": [
    {
      "kind": "api_key",
      "location": "header",
      "name": "X-API-Key",
      "ref_template": null
    }
  ],
  "id_scheme": "v1",
  "rights_basis": null,
  "rights_jurisdiction": null,
  "translation_nature": "community",
  "content_trust": "untrusted",
  "tests": []
}
