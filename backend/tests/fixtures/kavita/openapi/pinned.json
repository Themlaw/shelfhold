        }
       },
       "text/plain": {
        "schema": {
         "$ref": "#/components/schemas/ParseResultDto"
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "Parse a string and return Parsed information from it. Does not support any directory fallback parsing",
    "tags": [
     "Plugin"
    ]
   }
  },
