 "info": {
  "description": "Kavita provides a set of APIs authenticated via an Auth Key passed in the `x-api-key` header. Generate an Auth Key under User Settings \u2192 Manage Auth Keys, paste it into the Authorize panel, and all Try It requests will include it. Assume all fields of a payload are required unless marked optional. Built against v0.9.1.1",
  "license": {
   "name": "GPL-3.0",
   "url": "https://github.com/Kareadita/Kavita/blob/develop/LICENSE"
  },
  "title": "Kavita",
  "version": "0.9.1.1"
 },
 "openapi": "3.0.4",
 "paths": {
  "/api/Library/create": {
   "post": {
    "requestBody": {
     "content": {
      "application/*+json": {
       "schema": {
        "$ref": "#/components/schemas/UpdateLibraryDto"
       }
      },
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/UpdateLibraryDto"
       }
      },
      "text/json": {
       "schema": {
        "$ref": "#/components/schemas/UpdateLibraryDto"
       }
      }
     },
     "description": ""
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LibraryDto"
        }
       },
       "text/json": {
        "schema": {
         "$ref": "#/components/schemas/LibraryDto"
        }
       },
       "text/plain": {
        "schema": {
         "$ref": "#/components/schemas/LibraryDto"
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "Creates a new Library. Upon library creation, adds new library to all Admin accounts.",
    "tags": [
     "Library"
    ]
   }
  },
  "/api/Library/libraries": {
   "get": {
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/LibraryDto"
         },
         "type": "array"
        }
       },
       "text/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/LibraryDto"
         },
         "type": "array"
        }
       },
       "text/plain": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/LibraryDto"
         },
         "type": "array"
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "Return all libraries in the Server",
    "tags": [
     "Library"
    ]
   }
  },
  "/api/Library/scan-folder": {
   "post": {
    "requestBody": {
     "content": {
      "application/*+json": {
       "schema": {
        "$ref": "#/components/schemas/ScanFolderDto"
       }
      },
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ScanFolderDto"
       }
      },
      "text/json": {
       "schema": {
        "$ref": "#/components/schemas/ScanFolderDto"
       }
      }
     },
     "description": ""
    },
    "responses": {
     "200": {
      "description": "OK"
     }
    },
    "summary": "Given a valid path, will invoke either a Scan Series or Scan Library. If the folder does not exist within Kavita, the request will be ignored",
    "tags": [
     "Library"
    ]
   }
  },
  "/api/Library/type": {
   "get": {
    "parameters": [
     {
      "description": "",
      "in": "query",
      "name": "libraryId",
      "schema": {
       "format": "int32",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LibraryType"
        }
       },
       "text/json": {
        "schema": {
         "$ref": "#/components/schemas/LibraryType"
        }
       },
       "text/plain": {
        "schema": {
         "$ref": "#/components/schemas/LibraryType"
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "Returns the type of the underlying library",
    "tags": [
     "Library"
    ]
   }
  },
  "/api/Library/update": {
   "post": {
    "description": "Any folder or type change will invoke a scan.",
    "requestBody": {
     "content": {
      "application/*+json": {
       "schema": {
        "$ref": "#/components/schemas/UpdateLibraryDto"
       }
      },
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/UpdateLibraryDto"
       }
      },
      "text/json": {
       "schema": {
        "$ref": "#/components/schemas/UpdateLibraryDto"
       }
      }
     },
     "description": ""
    },
    "responses": {
     "200": {
      "description": "OK"
     }
    },
    "summary": "Updates an existing Library with new name, folders, and/or type.",
    "tags": [
     "Library"
    ]
   }
  },
  "/api/Plugin/authkey-expires": {
   "get": {
    "description": "Will always return null if the Auth Key does not belong to this account",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AuthKeyExpiresAtDto"
        }
       },
       "text/json": {
        "schema": {
         "$ref": "#/components/schemas/AuthKeyExpiresAtDto"
        }
       },
       "text/plain": {
        "schema": {
         "$ref": "#/components/schemas/AuthKeyExpiresAtDto"
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "Returns the expiration (UTC) of the authenticated Auth key (or null if none set)",
    "tags": [
     "Plugin"
    ]
   }
  },
  "/api/Plugin/parse": {
   "get": {
    "parameters": [
     {
      "description": "String to parse",
      "in": "query",
      "name": "name",
      "schema": {
       "maxLength": 1000,
       "minLength": 0,
       "type": "string"
      }
     },
     {
      "description": "Determines the set of pattern matching to use",
      "in": "query",
      "name": "libraryType",
      "schema": {
       "$ref": "#/components/schemas/LibraryType"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ParseResultDto"
        }
       },
       "text/json": {
        "schema": {
