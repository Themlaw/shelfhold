{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:minimumReleaseAgePypi"
  ],
  "minimumReleaseAge": "7 days",
  "dependencyDashboard": true,
  "pinDigests": true,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Huey reste sous 3.6 (ADR-0005)",
      "matchPackageNames": ["huey"],
      "allowedVersions": "<3.6"
    },
    {
      "description": "Automerge des patchs et des dependances de dev apres CI verte",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["dependency-groups"],
      "automerge": true
    }
  ]
}
