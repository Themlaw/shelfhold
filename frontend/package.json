{
  "name": "shelfhold-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "api:generate": "svelte-kit sync && openapi-ts",
    "dev": "npm run tokens && vite dev",
    "build": "npm run tokens && vite build && vite build --config vite.reader.config.ts",
    "check": "npm run tokens && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "npm run tokens && svelte-kit sync && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.12",
    "@vite-pwa/sveltekit": "^2.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^2.15.0",
    "parse5": "^8.1.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "bits-ui": "2.20.6",
    "intl-messageformat": "^12.2.0",
    "qrcode-generator": "^2.0.4"
  }
}
