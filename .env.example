# Shelfhold settings for docker compose. Copy this file to `.env` next to the compose file and edit
# it: both compose files read `.env` when it exists (it is never committed). Every setting is
# optional; the full list, with types and limits, is in docs/configuration.md and
# docs/reference/config.md. Any variable also accepts a `_FILE` suffix to read its value from a
# file (Docker secrets), e.g. SHELFHOLD_SETUP_TOKEN_FILE=/run/secrets/setup_token.

# Time zone of the logs and of the maintenance window.
TZ=Etc/UTC
SHELFHOLD_TIMEZONE=Europe/Paris

# First start: a secret of at least 24 characters (`openssl rand -hex 24`) that opens the
# "Your account" screen of the browser wizard once. It opens nothing once an administrator exists.
# Unset: create the administrator with `docker compose exec shelfhold shelfhold admin create`.
#SHELFHOLD_SETUP_TOKEN=

# The public address, when Shelfhold is behind an HTTPS reverse proxy. Required for e-readers
# (OPDS and kosync device tokens), and it gives the cookies `Secure` and the `__Host-` prefix.
#SHELFHOLD_PUBLIC_URL=https://shelfhold.example.org

# The reverse proxies in front of Shelfhold (CIDR, comma-separated): only they may set the
# client address headers.
#SHELFHOLD_HTTP_TRUSTED_PROXIES=172.18.0.2/32

# Hardened authentication profile: short admin sessions, password asked again for every reserved
# action, API keys expire within 90 days (docs/admin/durcir.md).
#SHELFHOLD_AUTH_HARDENED=true

# Logs: DEBUG, INFO, WARNING or ERROR.
#SHELFHOLD_LOG_LEVEL=INFO

# Built-in backup: a folder outside /data and /store (mount it in the compose file too) and a
# passphrase file of at least 12 characters, mode 0600 (docs/admin/sauvegarde.md).
#SHELFHOLD_BACKUP_DIR=/backup
#SHELFHOLD_BACKUP_PASSPHRASE_FILE=/run/secrets/backup_passphrase

# Import folder for your own CBZ, EPUB and PDF files (mount ./import:/import in the compose file).
#SHELFHOLD_IMPORT_DIR=/import

# Prometheus metrics on GET /metrics (no titles, profiles or paths).
#SHELFHOLD_METRICS_ENABLED=false
